# Безопасный пример. Реальные секреты храните только в .env.
BOT_TOKEN=
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
# TELEGRAM_SESSION_PATHS не задаётся: сохраняется прежний путь session_path().
# Явный путь: TELEGRAM_SESSION_PATHS=["C:/Users/USER/AppData/Local/TelegramLeads/monitor.session"]
ADMIN_IDS=[]
DATABASE_URL=sqlite+aiosqlite:///./monitor.sqlite3
ALLOW_SCHEMA_CHANGES=false
CHECK_NETWORK=false
DISPLAY_TZ=Europe/Moscow
LOG_LEVEL=INFO

DRY_RUN=true
ADMIN_ONLY_DELIVERY=true
DEFAULT_MIN_SCORE=50
TRIAL_DAYS=3
# Пример тарифов: дни -> Stars. Оплата выключена.
SUBSCRIPTION_PLANS={"7":100,"30":300,"90":800}
PAYMENTS_ENABLED=false

LLM_ENABLED=false
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_CONCURRENCY=1
LLM_MAX_ATTEMPTS=3
RETRY_INITIAL_SECONDS=5
RETRY_MAX_SECONDS=300

AUTO_JOIN=false
MAX_CHATS=450
DAILY_JOIN_LIMIT=10
JOIN_PAUSE_MIN_SECONDS=60
JOIN_PAUSE_MAX_SECONDS=120
DISCOVERY_INTERVAL_SECONDS=86400
SOURCE_REFRESH_SECONDS=60
MIN_CHAT_PARTICIPANTS=300
ACTIVITY_SAMPLE_LIMIT=50
ACTIVITY_WINDOW_DAYS=7
MIN_ACTIVE_MESSAGES=10
MIN_UNIQUE_AUTHORS=5

MIN_MESSAGE_LENGTH=30
DEDUP_WINDOW_HOURS=24
DELIVERY_MESSAGES_PER_SECOND=20
SPAM_DISTINCT_USER_THRESHOLD=3
LEAD_RETENTION_DAYS=30
AUTO_DELETE_LEADS=false
TELEGRAM_TEXT_LIMIT=4096
CALLBACK_DATA_MAX_BYTES=64
LEAD_EXCERPT_LENGTH=300
SUMMARY_MAX_LENGTH=120
SUBSCRIPTION_REMINDER_HOURS=24

SQLITE_TIMEOUT_SECONDS=10
SERVICE_RETRY_INITIAL_SECONDS=5
SERVICE_RETRY_MAX_SECONDS=300
SERVICE_MAX_RESTARTS=5

NETWORK_TIMEOUT_SECONDS=30
LLM_HEALTH_MAX_TOKENS=16
# Только для Docker: абсолютный путь к существующей сессии на хосте.
TELEGRAM_SESSION_HOST=

DEFAULT_CATEGORY_SLUG=web_dev
SCORE_CHOICES=[30,50,70,90]
GEO_MAX_LENGTH=100

READER_REFRESH_SECONDS=60
READER_POLL_SECONDS=1
READER_RPC_INTERVAL_SECONDS=2
READER_SOURCE_INTERVAL_SECONDS=20
READER_INITIAL_HISTORY_LIMIT=100
READER_HISTORY_BATCH_SIZE=100
READER_SOURCE_MAX_ATTEMPTS=5
INGEST_MAX_ATTEMPTS=3
INGEST_LEASE_SECONDS=120
INGEST_POLL_SECONDS=1
KEYWORD_MAX_LENGTH=100
ADMIN_LIST_LIMIT=20
REGEX_TEXT_LIMIT=512
# DEFAULT_KEYWORDS и DEFAULT_EXCLUDE_KEYWORDS — JSON при необходимости переопределения.

READER_FLOOD_PADDING_SECONDS=1

# Этап 3б: поиск только читает, вступления требуют одобрения или AUTO_JOIN=true.
# DRY_RUN=true блокирует вступления даже после одобрения.
# DISCOVERY_QUERIES={"web_dev":["заказы разработка","фриланс сайты"]}
DISCOVERY_SEARCH_LIMIT=50
DISCOVERY_MAX_ATTEMPTS=3
GROWTH_POLL_SECONDS=5
JOIN_MAX_ATTEMPTS=3
JOIN_LEASE_SECONDS=300
DIALOG_SCAN_LIMIT=2000
CANDIDATE_PAGE_SIZE=5
LINK_SCAN_BATCH=100
LINKS_PER_MESSAGE=20
SOURCE_REVIEW_DAYS=30
SOURCE_REVIEW_INTERVAL_DAYS=7
CAPTCHA_WORDS=["captcha","капча","verify","подтвердите","проверку"]

# Этап 4: только локальный OpenAI-совместимый endpoint; LLM_ENABLED=false по умолчанию.
# При выключенной LLM кандидаты ждут, без фиктивной оценки.
LLM_MIN_INTERVAL_SECONDS=1
LLM_MAX_RESPONSE_BYTES=65536
LLM_MAX_INPUT_CHARS=16000
LLM_CLASSIFY_MAX_TOKENS=256
LLM_DRAFT_MAX_TOKENS=512
CLASSIFIER_POLL_SECONDS=1
CLASSIFIER_LEASE_SECONDS=120
DELIVERY_POLL_SECONDS=1
DELIVERY_LEASE_SECONDS=120
DELIVERY_MAX_ATTEMPTS=5
DELIVERY_BATCH_SIZE=100
DRAFT_MAX_LENGTH=1200
DRAFT_LEASE_SECONDS=120

# Компании с неуказанным сайтом: отдельный источник, без автообращений.
COMPANY_MONITOR_ENABLED=false
COMPANY_RENDER_ENABLED=false
COMPANY_CITIES=["Москва","Ярославль"]
COMPANY_QUERIES=["авто из Китая","привоз автомобилей из Китая","импорт автомобилей из Китая"]
COMPANY_REQUEST_INTERVAL_SECONDS=5
COMPANY_TIMEOUT_SECONDS=30
COMPANY_MAX_PAGE_BYTES=4000000
COMPANY_MAX_PAGES=2
COMPANY_CARDS_PER_QUERY=20
COMPANY_MAX_ATTEMPTS=3
COMPANY_POLL_SECONDS=5
COMPANY_PAGE_SIZE=5
COMPANY_BROWSER_BUDGET_MS=7000
COMPANY_IMPORT_LIMIT=1000
# Необязательный путь к установленному Chrome/Chromium/Edge (без кавычек внутри значения):
# CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
